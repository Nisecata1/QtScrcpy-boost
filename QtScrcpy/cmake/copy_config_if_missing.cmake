if(NOT DEFINED SRC OR SRC STREQUAL "" OR NOT DEFINED DST OR DST STREQUAL "")
    message(FATAL_ERROR "Usage: cmake -DSRC=<dir> -DDST=<dir> -P copy_config_if_missing.cmake")
endif()

file(MAKE_DIRECTORY "${DST}")
file(GLOB_RECURSE qsc_config_files RELATIVE "${SRC}" "${SRC}/*")
foreach(rel_file IN LISTS qsc_config_files)
    set(src_file "${SRC}/${rel_file}")
    set(dst_file "${DST}/${rel_file}")
    if(IS_DIRECTORY "${src_file}")
        file(MAKE_DIRECTORY "${dst_file}")
    elseif(NOT EXISTS "${dst_file}")
        get_filename_component(dst_parent "${dst_file}" DIRECTORY)
        file(MAKE_DIRECTORY "${dst_parent}")
        file(COPY_FILE "${src_file}" "${dst_file}")
    endif()
endforeach()
